<?xml version="1.0"?>
<!--
  Modelo del robot diferencial (Jetson Nano + FeatherWing + 2 motores TT + camara Raspberry Pi v1.3).

  Frames:
    odom -> base_link         lo publica motor_driver_node (odometria)
    base_link -> resto        los publica robot_state_publisher (juntas fijas de este URDF)

  base_link esta en el centro del eje de las ruedas, a la altura del eje.
  Convenio ROS: X hacia delante, Y hacia la izquierda, Z hacia arriba. Unidades en metros.

  IMPORTANTE: solo wheel_separation (0.125) viene de tu motor_driver.
  El resto de medidas son ESTIMACIONES: mide el robot real y ajustalas.
    - radio de rueda: 0.0325  (rueda TT de 65 mm)
    - cuerpo: 0.20 x 0.11 x 0.06
    - posicion de la camara
  Medido: rueda loca a 9 cm por detras del eje de las ruedas motrices.
-->
<robot name="diff_robot">

  <material name="body_color"><color rgba="0.2 0.4 0.8 1.0"/></material>
  <material name="wheel_color"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="caster_color"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="camera_color"><color rgba="0.9 0.5 0.1 1.0"/></material>
  <material name="jetson_color"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <!-- ====== Cuerpo (base_link) ======
       Medidas estimadas a partir de la foto lateral (rueda de 65 mm como referencia):
       caja de unos 13 cm de largo, que va desde 1 cm detras de la rueda loca
       hasta 3 cm por delante del eje; base a ~2,5 cm del suelo, ~4 cm de alto. -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.035 0 0.0125" rpy="0 0 0"/>
      <geometry><box size="0.13 0.09 0.04"/></geometry>
      <material name="body_color"/>
    </visual>
    <collision>
      <origin xyz="-0.035 0 0.0125" rpy="0 0 0"/>
      <geometry><box size="0.13 0.09 0.04"/></geometry>
    </collision>
  </link>

  <!-- ====== Jetson Nano con disipador (piso superior) ======
       Entre ~7 y ~10 cm sobre el suelo. -->
  <link name="jetson_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.08 0.025"/></geometry>
      <material name="jetson_color"/>
    </visual>
  </link>
  <joint name="jetson_joint" type="fixed">
    <parent link="base_link"/>
    <child link="jetson_link"/>
    <origin xyz="-0.038 0 0.052" rpy="0 0 0"/>
  </joint>

  <!-- ====== Rueda izquierda (motor 1) ====== -->
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
      <material name="wheel_color"/>
    </visual>
  </link>
  <joint name="wheel_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.0625 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== Rueda derecha (motor 2) ====== -->
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
      <material name="wheel_color"/>
    </visual>
  </link>
  <joint name="wheel_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.0625 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== Rueda loca (caster) trasera ====== -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0125"/></geometry>
      <material name="caster_color"/>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.09 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- ====== Camara Raspberry Pi v1.3 (CSI) ====== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.025 0.024"/></geometry>
      <material name="camera_color"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- PROVISIONAL: ajustar a donde quede montada la camara. -->
    <origin xyz="0.04 0 0.0425" rpy="0 0 0"/>
  </joint>

  <!-- Frame optico: el que usa rpi_camera_node en sus mensajes.
       Convencion optica: Z hacia delante, X a la derecha, Y hacia abajo. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>


  <!-- RPLIDAR C1. z = 0.20 m del suelo - 0.0325 (radio rueda, base_link esta en el eje).
       Cable hacia atras = yaw 0 (confirmado). PROVISIONAL: x/y por medir. -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.028" length="0.04"/></geometry>
      <material name="lidar_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0.1675" rpy="0 0 0"/>
  </joint>

</robot>
